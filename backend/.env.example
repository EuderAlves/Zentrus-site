PORT=3333
CORS_ORIGIN=http://localhost:5173

# Email que recebera os pedidos de orcamento.
OWNER_EMAIL=euder.alv@gmail.com

# Crie uma chave em https://resend.com/api-keys
RESEND_API_KEY=

# Para producao, use um dominio verificado no Resend.
# Em testes, o Resend permite usar o remetente de onboarding.
RESEND_FROM_EMAIL=Zentrus Tecnologia <onboarding@resend.dev>

# Use false enquanto estiver com onboarding@resend.dev.
# Troque para true depois de verificar um dominio proprio no Resend.
RESEND_SEND_CUSTOMER_CONFIRMATION=false
